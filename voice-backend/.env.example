# OpenAI GPT-Live
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=

# Default business profile (additional businesses are added through the admin API)
DEFAULT_BUSINESS_ID=west-island-home-services
BUSINESS_NAME=West Island Home Services
OWNER_FIRST_NAME=John
BUSINESS_TRADE=hvac
BUSINESS_TIMEZONE=America/Toronto
CALLPILOT_NUMBER=+14385550142
OWNER_PHONE=
OWNER_TRANSFER_URI=
SERVICE_AREAS=Kirkland,Pointe-Claire,Beaconsfield,Dollard-des-Ormeaux
CALENDAR_MODE=internal

# Optional owner SMS notifications through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Backend security / storage
ADMIN_TOKEN=
CALLPILOT_DB_PATH=callpilot.db
ALLOW_SINGLE_BUSINESS_FALLBACK=true
DEMO_MODE=true
PORT=3000

# Calendar OAuth (server-side; never commit real secrets)
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Website voice demo (no Twilio or phone number required)
# Keep both values on the server. DEMO_VOICE_TOKEN is a private demo access code.
DEMO_VOICE_TOKEN=
DEMO_VOICE_ORIGINS=https://nicolaschoueri.github.io,http://localhost:3000
